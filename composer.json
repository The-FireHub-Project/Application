{
  "name": "the-firehub-project/application",
  "description": "Application lifecycle management and orchestration runtime for The FireHub Project.",
  "type": "library",
  "keywords": ["php", "framework", "application", "firehub"],
  "homepage": "https://the-firehub-project.github.io/application",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.5",

    "the-firehub-project/core-standard": "dev-develop",
    "the-firehub-project/runtime": ">=0.1.0 <1.0.0",
    "the-firehub-project/foundation": "dev-develop",
    "the-firehub-project/kernel": "dev-develop"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "the-firehub-project/phpstan-rules": "dev-develop",

    "the-firehub-project/testing": "dev-develop"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "FireHub\\Application\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FireHub\\Tests\\Application\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Danijel Galić",
      "email": "danijel.galic@outlook.com",
      "homepage": "https://github.com/dieselxxx",
      "role": "Owner"
    }
  ],
  "support": {
    "email": "danijel.galic@outlook.com",
    "issues": "https://github.com/The-FireHub-Project/Application/issues",
    "forum": "https://github.com/orgs/The-FireHub-Project/discussions",
    "wiki": "https://github.com/The-FireHub-Project/Application/wiki",
    "source": "https://github.com/The-FireHub-Project/Application",
    "docs": "https://the-firehub-project.github.io/Application",
    "security": "https://github.com/The-FireHub-Project/Application/security/policy"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/The-FireHub-Project"
    }
  ],
  "config": {
    "prepend-autoloader": false,
    "optimize-autoloader": true,
    "platform-check": true
  },
  "extra": {
    "firehub": {
      "layer": "runtime",
      "edition": "standard",
      "role": "orchestration",
      "criticality": "high"
    }
  }
}